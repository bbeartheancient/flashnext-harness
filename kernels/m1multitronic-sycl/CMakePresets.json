{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "default",
      "displayName": "oneAPI Ninja Release",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "icpx"
      }
    },
    {
      "name": "debug",
      "inherits": "default",
      "displayName": "oneAPI Ninja Debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "llvm7",
      "displayName": "intel/llvm v7.0.0 Ninja Release (B70 joint_matrix)",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build-llvm7",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_CXX_COMPILER": "clang++",
        "AFI_TORCH": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "default", "configurePreset": "default" },
    { "name": "debug", "configurePreset": "debug" },
    { "name": "llvm7", "configurePreset": "llvm7" }
  ]
}
